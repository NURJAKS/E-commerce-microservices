{
  "name": "shop-monorepo",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && node scripts/link-paths.js && vite build --config apps/client/vite.config.ts",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate --schema=apps/auth-service/prisma/schema.prisma && prisma generate --schema=apps/catalog-service/prisma/schema.prisma && prisma generate --schema=apps/order-service/prisma/schema.prisma && prisma generate --schema=apps/payment-service/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=apps/auth-service/prisma/schema.prisma && prisma db push --schema=apps/catalog-service/prisma/schema.prisma && prisma db push --schema=apps/order-service/prisma/schema.prisma && prisma db push --schema=apps/payment-service/prisma/schema.prisma",
    "dev:gateway": "tsx watch apps/api-gateway/src/main.ts",
    "dev:auth": "tsx watch apps/auth-service/src/main.ts",
    "dev:catalog": "tsx watch apps/catalog-service/src/main.ts",
    "dev:order": "tsx watch apps/order-service/src/main.ts",
    "dev:payment": "tsx watch apps/payment-service/src/main.ts",
    "dev:notification": "tsx watch apps/notification-service/src/main.ts",
    "dev:client": "vite --config apps/client/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/platform-socket.io": "^10.3.10",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.3.10",
    "@prisma/client": "^5.20.0",
    "amqplib": "^0.10.4",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "lucide-vue-next": "^0.445.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pinia": "^2.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "vue": "^3.5.8",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.3.10",
    "@nx/js": "^19.8.0",
    "@nx/nest": "^19.8.0",
    "@nx/vite": "^19.8.0",
    "@nx/vue": "^19.8.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "nx": "^19.8.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.7",
    "vitest": "^2.1.1",
    "vue-tsc": "^2.1.6"
  }
}
