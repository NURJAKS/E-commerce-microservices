# Database URLs (Isolated PostgreSQL logical databases)
AUTH_DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/auth_db?schema=public"
CATALOG_DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/catalog_db?schema=public"
ORDER_DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/order_db?schema=public"
PAYMENT_DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/payment_db?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# RabbitMQ
RABBITMQ_URL="amqp://guest:your_password_here@localhost:5672"

# JWT Security
JWT_ACCESS_SECRET="your_jwt_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_TTL_DAYS="7"

# Internal Microservice TCP Ports
API_GATEWAY_PORT="3000"
AUTH_SERVICE_HOST="localhost"
AUTH_SERVICE_PORT="3001"
CATALOG_SERVICE_HOST="localhost"
CATALOG_SERVICE_PORT="3002"
ORDER_SERVICE_HOST="localhost"
ORDER_SERVICE_PORT="3003"
PAYMENT_SERVICE_HOST="localhost"
PAYMENT_SERVICE_PORT="3004"
NOTIFICATION_SERVICE_PORT="3005"

# MinIO S3 Object Storage
MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="your_minio_access_key_here"
MINIO_SECRET_KEY="your_password_here"
MINIO_BUCKET="products-media"

# Mailpit SMTP
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="no-reply@shop-monorepo.local"
