# ==============================================================================
# NovaShop Production Environment Template (Server-only `.env`, chmod 600)
# NEVER commit real secrets to Git! Copy this to `/opt/novashop/.env` on your VPS.
# ==============================================================================

# Container Registry (GitHub Container Registry)
GHCR_PREFIX=ghcr.io/your-org/e-commerce-architecture
IMAGE_TAG=latest

# Public Internet Domain (HTTPS recommended via Cloudflare / Caddy / Certbot TLS)
FRONTEND_PUBLIC_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com
# Point MINIO_PUBLIC_URL to your public HTTPS domain so Nginx proxies
# /products-media/* and /invoices-private/* cleanly over HTTPS (port 9000 stays private)
MINIO_PUBLIC_URL=https://shop.example.com
PUBLIC_HTTP_PORT=80

# Horizontal Scaling Replicas (adjust based on VPS vCPU count)
API_GATEWAY_REPLICAS=2
CATALOG_REPLICAS=2
ORDER_REPLICAS=2
AUTH_REPLICAS=1
PAYMENT_REPLICAS=1

# Production Logging (quiet HTTP logs for low latency; logs slow requests >= 250ms)
LOG_HTTP_REQUESTS=false
SLOW_HTTP_LOG_MS=250

# Cryptographic Secrets (generate with: `openssl rand -hex 32`)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_SEPARATE_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=7

# Optional initial admin bootstrap (set true ONLY for first boot with strong password, then set false)
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=admin@shop.example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Infrastructure Credentials
POSTGRES_USER=novashop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
RABBITMQ_USER=novashop
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_SECRET_KEY
MINIO_BUCKET=products-media
MINIO_INVOICE_BUCKET=invoices-private

# Production SMTP (Resend / SendGrid / AWS SES / Mailgun / Postmark)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_SMTP_API_KEY
SMTP_FROM=no-reply@shop.example.com

# Optional: Stripe Live / Test Checkout + Signed Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Google OAuth 2.0 (register GOOGLE_CALLBACK_URL in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://shop.example.com/api/auth/google/callback

# Optional: Auto-detected from FRONTEND_PUBLIC_URL (https => true, http => false)
COOKIE_SECURE=
ALLOW_PUBLIC_SAGA_MONITOR=false
