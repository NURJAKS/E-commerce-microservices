generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/catalog-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  slug     String     @unique
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id                String             @id @default(uuid()) @db.Uuid
  title             String
  description       String
  price             Decimal            @db.Decimal(12, 2)
  stock             Int                @default(0)
  images            String[]
  categoryId        String             @db.Uuid
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isActive          Boolean            @default(true)
  version           Int                @default(1)
  avgRating         Decimal            @default(0) @db.Decimal(3, 2)
  reviewsCount      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockMovements    StockMovement[]
  reviews           Review[]
  verifiedPurchases VerifiedPurchase[]
  stockAlerts       StockAlertSubscription[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, categoryId, createdAt(sort: Desc)])
}

model VerifiedPurchase {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String   @db.Uuid
  purchasedAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  userEmail String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, createdAt(sort: Desc)])
}

model StockAlertSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?   @db.Uuid
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@index([productId, notifiedAt])
}

enum StockMovementType {
  ORDER_RESERVED
  PAYMENT_FAILED_RESTORE
  REFUND_RESTORE
  ADMIN_ADJUSTMENT
}

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  productId String            @db.Uuid
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?           @db.Uuid
  delta     Int
  type      StockMovementType
  reason    String?
  createdAt DateTime          @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@index([orderId])
}

model Discount {
  id             String               @id @default(uuid()) @db.Uuid
  code           String               @unique
  percentage     Int                  @default(0)
  fixedAmount    Decimal              @default(0) @db.Decimal(12, 2)
  validFrom      DateTime
  validUntil     DateTime
  maxUses        Int?
  maxUsesPerUser Int?
  usedCount      Int                  @default(0)
  isActive       Boolean              @default(true)
  redemptions    DiscountRedemption[]

  @@index([code])
  @@index([isActive, validFrom, validUntil])
}

model DiscountRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  discountId String   @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  orderId    String   @unique @db.Uuid
  redeemedAt DateTime @default(now())

  @@index([discountId, userId])
  @@index([userId])
}

model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
}
